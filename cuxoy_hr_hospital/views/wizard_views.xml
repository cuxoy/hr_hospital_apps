<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Mass Reassign Doctor Wizard Form -->
    <record id="view_mass_reassign_doctor_wizard_form" model="ir.ui.view">
        <field name="name">mass.reassign.doctor.wizard.form</field>
        <field name="model">mass.reassign.doctor.wizard</field>
        <field name="arch" type="xml">
            <form string="Mass Reassign Doctor">
                <group>
                    <field name="new_doctor_id"/>
                    <field name="change_date"/>
                </group>
                <footer>
                    <button name="action_reassign_doctor"
                            type="object"
                            string="Reassign Doctor"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Mass Reassign Doctor Action -->
    <record id="action_mass_reassign_doctor_wizard" model="ir.actions.act_window">
        <field name="name">Mass Reassign Doctor</field>
        <field name="res_model">mass.reassign.doctor.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_hospital_patient"/>
        <field name="binding_view_types">list</field>
    </record>


    <!-- Visit Report Wizard Form -->
    <record id="view_visit_report_wizard_form" model="ir.ui.view">
        <field name="name">visit.report.wizard.form</field>
        <field name="model">visit.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Visit Report">
                <group>
                    <field name="doctor_ids" widget="many2many_tags"/>
                    <field name="patient_ids" widget="many2many_tags"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="only_done"/>
                    <field name="disease_id"/>
                </group>
                <footer>
                    <button name="action_show_visits"
                            type="object"
                            string="Show Visits"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Visit Report Action from Patients -->
    <record id="action_visit_report_wizard_from_patient" model="ir.actions.act_window">
        <field name="name">Visit Report</field>
        <field name="res_model">visit.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_hospital_patient"/>
        <field name="binding_view_types">list,form</field>
    </record>

    <!-- Visit Report Action from Doctors -->
    <record id="action_visit_report_wizard_from_doctor" model="ir.actions.act_window">
        <field name="name">Visit Report</field>
        <field name="res_model">visit.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_hospital_doctor"/>
        <field name="binding_view_types">list,form</field>
    </record>

    <record id="view_disease_monthly_report_wizard_form" model="ir.ui.view">
        <field name="name">disease.monthly.report.wizard.form</field>
        <field name="model">disease.monthly.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Disease Monthly Report">
                <group>
                    <field name="doctor_ids" widget="many2many_tags"/>
                    <field name="disease_ids" widget="many2many_tags"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_show_report"
                            type="object"
                            string="Show Report"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_disease_monthly_report_wizard" model="ir.actions.act_window">
        <field name="name">Disease Monthly Report</field>
        <field name="res_model">disease.monthly.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_hospital_doctor"/>
        <field name="binding_type">report</field>
        <field name="binding_view_types">list,form</field>
    </record>

</odoo>