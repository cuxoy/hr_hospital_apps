<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_hospital_patient_list" model="ir.ui.view">
        <field name="name">hospital.patient.list</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="phone"/>
                <field name="gender"/>
                <field name="blood_group"/>
                <field name="birth_date"/>
                <field name="age"/>
                <field name="personal_doctor_id"/>
                <field name="insurance_policy_number"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_patient_form" model="ir.ui.view">
        <field name="name">hospital.patient.form</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_visit"
                            type="object"
                            string="Create Visit"
                            class="btn-primary"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_patient_visits"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-calendar">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Visits</span>
                            </div>
                        </button>
                    </div>

                    <group>
                        <group string="General">
                            <field name="name"/>
                            <field name="phone"/>
                            <field name="active"/>
                            <field name="insurance_policy_number"/>
                        </group>

                        <group string="Medical Info">
                            <field name="gender"/>
                            <field name="blood_group"/>
                            <field name="birth_date"/>
                            <field name="age" readonly="1"/>
                        </group>
                    </group>

                    <group string="Doctor">
                        <field name="personal_doctor_id"/>
                    </group>

                    <group string="Personal Doctor History">
                        <field name="doctor_history_ids" readonly="1">
                            <list>
                                <field name="doctor_id"/>
                                <field name="assignment_date"/>
                                <field name="change_date"/>
                                <field name="active"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hospital_patient_search" model="ir.ui.view">
        <field name="name">hospital.patient.search</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Patient Name"/>
                <field name="phone" string="Phone"/>
                <field name="personal_doctor_id"/>
                <filter name="active_patients"
                        string="Active"
                        domain="[('active', '=', True)]"/>
                <filter name="group_by_doctor"
                        string="Group by Doctor"
                        context="{'group_by': 'personal_doctor_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_hospital_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">hospital.patient</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hospital_patient_search"/>
    </record>
</odoo>